        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "max by (name) (k6_http_req_duration_p95)",
          "legendFormat": "p95 {{name}}"
        },
        {
          "datasource": {
