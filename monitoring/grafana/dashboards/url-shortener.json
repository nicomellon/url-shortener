    {
      "type": "timeseries",
      "title": "Response time percentiles (as users see it)",
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Measured by the client, so it includes network and queueing time. DDIA's 'response time', where the API's panel is closer to 'service time'.",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
