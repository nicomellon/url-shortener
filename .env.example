# Copy to .env for local development. Never commit .env.
# In other environments, set these as real environment variables.
DATABASE_URL=postgresql+psycopg://url_shortener:url_shortener@localhost:5432/url_shortener
PORT=8000
LOG_LEVEL=INFO
# Log every HTTP request. Turn off under heavy load: logging costs CPU per request.
ACCESS_LOG=true
# API worker processes. Each has its own connection pool, so keep
# WEB_CONCURRENCY * (DB_POOL_SIZE + DB_MAX_OVERFLOW) below Postgres' max_connections (100).
WEB_CONCURRENCY=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
